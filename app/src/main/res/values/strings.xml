    <string name="accessibility_service_description">선택한 앱이 화면에 표시될 때 앱 이름만 확인하고 세로 방향을 요청합니다. 화면 내용은 저장하거나 전송하지 않습니다.</string>
    <string name="app_selection_title">앱 선택</string>
